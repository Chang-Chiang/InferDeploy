# gcc 和 cuda 版本
# 本机当前为 CUDA 13.4（/usr/local/cuda -> cuda-13.4）+ 驱动 595.99.02；
# CUDA 12.4 已从 /usr 下的 apt 包中移除，所以 CUDA_DIR 改指 toolkit 安装前缀，
# 库目录也从 deb 布局的 lib/x86_64-linux-gnu 改为 toolkit 布局的 lib64。
# 兼容性依据（实测）：libnvinfer.so.10 的未定义符号中 cuda*/cublas* 为 0 个
#（TRT 10 自己加载驱动），故应用侧链 cu13 运行库可与 cu12 构建的 TRT 10.16 共存。
CXX                         :=  g++
CUDA_VER                    :=  13.4

# CUDA 安装前缀与其库目录（deb 安装可改成 /usr 与 /usr/lib/x86_64-linux-gnu）
CUDA_DIR                    :=  /usr/local/cuda
CUDA_LIB_DIR                :=  $(CUDA_DIR)/lib64

# OpenCV 和 TensorRT 安装目录
OPENCV_INSTALL_DIR          :=  /usr/include/opencv4
# TensorRT 10.16（pip 安装的 tensorrt-cu12 库 + GitHub 开源仓库头文件，支持 Blackwell GPU）
TENSORRT_INSTALL_DIR        :=  $(shell pwd)/deps/TensorRT-10.16/usr

# OpenVINO 推理后端（pip 安装的 openvino wheel，含 runtime 库与头文件）
# 置 1 时编译 OvBackend 并链接 OpenVINO，支持 m_eBackend = OPENVINO
ENABLE_OPENVINO             :=  1
OPENVINO_INSTALL_DIR        :=  $(shell pwd)/deps/OpenVINO/usr

# 本机：RTX 5070 Ti（Blackwell，sm_120 / cc 12.0）+ CUDA 13.4（nvcc 已认识 compute_120）
# → 只嵌原生 SASS，不走驱动 JIT；CUDA 13 生成的 PTX（ISA 9.4）比驱动上限（CUDA 13.2）新，
#   纯 PTX 目标运行时会报 "the provided PTX was compiled with an unsupported toolchain"
# 注：CUDA 13 已移除 compute_60/61/70/72 等旧架构（nvcc --list-gpu-arch 从 sm_75 起步）
ARCH= -gencode arch=compute_120,code=sm_120

# GeForce RTX 3070, 3080, 3090
# ARCH= -gencode arch=compute_86,code=[sm_86,compute_86]

# Tesla A100 (GA100), DGX-A100, RTX 3080
# ARCH= -gencode arch=compute_80,code=[sm_80,compute_80]

# GeForce RTX 2080 Ti, RTX 2080, RTX 2070, Quadro RTX 8000/6000/5000, Tesla T4
# ARCH= -gencode arch=compute_75,code=[sm_75,compute_75]

# 以下均为 CUDA 13 已下线的架构，仅当回退到 CUDA 12.x 工具链时可用：
# Kepler GeForce GTX 770, GTX 760, GT 740
# ARCH= -gencode arch=compute_30,code=sm_30

# Tesla V100
# ARCH= -gencode arch=compute_70,code=[sm_70,compute_70]

# Jetson XAVIER
# ARCH= -gencode arch=compute_72,code=[sm_72,compute_72]

# GTX 1080, GTX 1070, GTX 1060, GTX 1050, GTX 1030, Titan Xp, Tesla P40, Tesla P4
# ARCH= -gencode arch=compute_61,code=sm_61 -gencode arch=compute_61,code=compute_61

# GP100/Tesla P100 - DGX-1
# ARCH= -gencode arch=compute_60,code=sm_60

# For Jetson TX1, Tegra X1, DRIVE CX, DRIVE PX - uncomment:
# ARCH= -gencode arch=compute_53,code=[sm_53,compute_53]

# For Jetson Tx2 or Drive-PX2 uncomment:
# ARCH= -gencode arch=compute_62,code=[sm_62,compute_62]
#


# Compile options
DEBUG                       :=  1
SHOW_WARNING                :=  0

# Compile applications
APP                         :=  trt-infer
